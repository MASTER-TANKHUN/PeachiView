---
import { Picture } from 'astro:assets';
import Win from './Win.astro';
import Scribble from './svg/Scribble.astro';
import PeachMascot from './svg/PeachMascot.astro';
import avatar from '../assets/models/v3-avatar.png';
import { profile, stats, daysWaited } from '../data/site';

const stickers = [
  { cls: 's-peach', kind: 'peach' },
  { cls: 's-cat', icon: 'cat', color: 'var(--ink)' },
  { cls: 's-ghost', icon: 'ghost', color: 'var(--ink)' },
  { cls: 's-pad', icon: 'pad', color: 'var(--ink)' },
  { cls: 's-cube', icon: 'cube', color: 'var(--ink)' },
  { cls: 's-mic', icon: 'mic', color: 'var(--ink)' },
  { cls: 's-heart', icon: 'heart', color: 'var(--pink-400)' },
  { cls: 's-star', icon: 'star', color: '#ffc94d' },
  { cls: 's-text s-she', text: 'she/her' },
  { cls: 's-text s-th', text: 'VTuber 🇹🇭' },
  { cls: 's-text s-fan', text: 'ลูกพีชน้อย ♡' },
];
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="wrap about__head" data-reveal>
    <p class="kicker"><svg width="14" height="14" aria-hidden="true"><use href="#i-user"></use></svg> profile.exe</p>
    <h2 class="title-xl" id="about-title">รู้จัก <span class="hl">พีชชี่<Scribble /></span> กันหน่อย</h2>
    <p class="lead">
      "{profile.nick}" คือ VTuber สาวชาวไทยที่เริ่มจากศูนย์ ไม่รู้เลยว่าอนาคตจะเป็นยังไง จนได้มาเจอ YouTube และได้ค้นพบตัวเอง —
      ตอนนี้กลับมาพร้อม "พื้นที่เล็กๆ สำหรับงานสร้างสรรค์" ของตัวเอง
    </p>
  </div>

  <div class="wrap about__grid">
    <div class="card-stage" data-reveal>
      <button class="idcard" type="button" aria-pressed="false" aria-label="การ์ดประจำตัวพีชชี่ กดเพื่อพลิกดูด้านหลัง">
        <span class="idcard__inner">
          <span class="idcard__face idcard__front">
            <span class="idcard__top"><span>PEACHI · VTUBER ID</span><span>★ ★ ★ ★ ★</span></span>
            <span class="idcard__photo">
              <Picture src={avatar} alt="" widths={[360, 540, 720]} sizes="(max-width: 700px) 70vw, 340px" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" />
            </span>
            <span class="idcard__name">PeachiView <small>พีชชี่</small></span>
            <span class="idcard__row"><span>No. 0131-2021</span><span>TH · she/her</span></span>
            <span class="idcard__foil" aria-hidden="true"></span>
          </span>
          <span class="idcard__face idcard__back">
            <span class="idcard__top"><span>ABOUT ME</span><span>♡</span></span>
            <dl class="facts">
              {profile.facts.map((f) => (
                <div class="facts__row">
                  <dt>{f.k}</dt>
                  <dd>{f.v}</dd>
                </div>
              ))}
            </dl>
            <span class="barcode" aria-hidden="true"></span>
            <span class="idcard__foil" aria-hidden="true"></span>
          </span>
        </span>
      </button>
      <p class="hand card-hint" aria-hidden="true">กดเพื่อพลิกการ์ด ↻</p>
    </div>

    <div class="about__stats">
      <Win title="subscribers" icon="heart" class="stat-win" data-reveal>
        <p class="stat"><span data-count={stats.subscribers} data-format="k">{(stats.subscribers / 1000).toFixed(1)}K</span></p>
        <p class="stat__label">ผู้ติดตาม (ลูกพีชน้อย)</p>
      </Win>
      <Win title="views.log" icon="eye" class="stat-win" data-reveal>
        <p class="stat"><span data-count={stats.views}>{stats.views.toLocaleString('en-US')}</span></p>
        <p class="stat__label">ยอดวิวรวมทั้งช่อง</p>
      </Win>
      <Win title="videos/" icon="film" class="stat-win" data-reveal>
        <p class="stat"><span data-count={stats.videos}>{stats.videos}</span></p>
        <p class="stat__label">คลิป · ไลฟ์ · Shorts</p>
      </Win>
      <Win title="waiting.exe" icon="clock" class="stat-win" data-reveal>
        <p class="stat"><span data-count={daysWaited}>{daysWaited.toLocaleString('en-US')}</span></p>
        <p class="stat__label">วันที่ลูกพีชน้อยรอ</p>
      </Win>
      <div class="focus" data-reveal>
        <p class="hand focus__title">แนวใหม่ของปี 2026 ✦</p>
        <ul class="focus__list">
          {profile.focus.map((f) => <li>{f}</li>)}
        </ul>
        <p class="focus__tag">{profile.tagline} 🍑</p>
      </div>
    </div>
  </div>

  <div class="stickers" data-stickers>
    <p class="hand sticker-hint" aria-hidden="true">ลากสติกเกอร์เล่นได้นะ! ↷</p>
    {stickers.map((s) => (
      <div class:list={['sticker', s.cls]} aria-hidden="true">
        {s.kind === 'peach' ? (
          <PeachMascot id="st-peach" idle={false} />
        ) : s.icon ? (
          <svg style={`color:${s.color}`}><use href={`#i-${s.icon}`} /></svg>
        ) : (
          <span>{s.text}</span>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .about { padding: clamp(80px, 12vw, 160px) 0 clamp(80px, 10vw, 140px); overflow: clip; }
  .about__head { display: grid; justify-items: center; text-align: center; gap: 16px; margin-bottom: clamp(40px, 6vw, 72px); }
  .about__head .lead { max-width: 46ch; }
  .about__grid {
    position: relative; z-index: 2;
    display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 72px); align-items: center;
  }

  /* ── flip card ── */
  .card-stage { display: grid; justify-items: center; gap: 14px; perspective: 1400px; }
  .idcard {
    --rx: 0deg; --ry: 0deg; --flip: 0deg;
    position: relative; width: min(360px, 82vw); aspect-ratio: 5 / 7;
    padding: 0; border: 0; background: none; cursor: pointer;
    transform-style: preserve-3d;
  }
  .idcard__inner {
    position: absolute; inset: 0; display: block;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(calc(var(--ry) + var(--flip)));
    transition: transform 0.9s var(--ease-pop);
  }
  .idcard.is-tilting .idcard__inner { transition: transform 0.12s linear; }
  .idcard[aria-pressed='true'] { --flip: 180deg; }
  .idcard__face {
    position: absolute; inset: 0; display: flex; flex-direction: column; gap: 10px;
    padding: 14px; border-radius: 22px; overflow: hidden;
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
    background: linear-gradient(160deg, #fff 0%, #ffeef7 60%, #f3e8ff 100%);
    border: 3px solid #fff;
    box-shadow: 0 0 0 3px var(--pink-300), 0 30px 60px -24px rgba(201, 45, 130, 0.55);
    text-align: left;
  }
  .idcard__back { transform: rotateY(180deg); }
  .idcard__top {
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--font-pixel); font-weight: 500; font-size: 0.78rem; letter-spacing: 0.08em;
    color: #fff; background: linear-gradient(90deg, var(--pink-400), var(--lilac-400));
    padding: 6px 12px; border-radius: 10px;
  }
  .idcard__photo {
    position: relative; flex: 1; min-height: 0; border-radius: 14px; overflow: hidden; display: block;
    background: radial-gradient(circle at 50% 30%, #fff 0 25%, #ffd6ec 60%, #e7d6ff 100%);
    border: 2px solid var(--pink-200);
  }
  .idcard__photo img { position: absolute; left: 50%; top: 4%; width: 118%; max-width: none; height: auto; translate: -50% 0; }
  .idcard__name { font-family: var(--font-pixel); font-weight: 700; font-size: 1.7rem; line-height: 1; color: var(--pink-500); display: flex; align-items: baseline; gap: 10px; }
  .idcard__name small { font-family: var(--font-display); font-size: 1rem; color: var(--ink-soft); }
  .idcard__row { display: flex; justify-content: space-between; font-family: var(--font-pixel); font-size: 0.8rem; color: var(--ink-faint); }
  .idcard__foil {
    position: absolute; inset: 0; pointer-events: none; border-radius: inherit;
    background: linear-gradient(115deg, transparent 20%, rgba(255, 180, 230, 0.45) 36%, rgba(180, 220, 255, 0.45) 46%, rgba(255, 255, 255, 0.6) 50%, rgba(210, 180, 255, 0.45) 56%, transparent 72%);
    background-size: 250% 250%;
    background-position: var(--fx, 50%) var(--fy, 50%);
    mix-blend-mode: color-dodge; opacity: 0.55;
  }
  .facts { margin: 4px 0 0; display: grid; gap: 7px; }
  .facts__row { display: grid; grid-template-columns: 7.5em 1fr; gap: 8px; padding-bottom: 7px; border-bottom: 1.5px dashed var(--pink-200); }
  .facts dt { font-size: 0.78rem; color: var(--ink-faint); }
  .facts dd { margin: 0; font-size: 0.9rem; font-weight: 400; line-height: 1.4; }
  .barcode {
    margin-top: auto; height: 38px; border-radius: 6px; display: block;
    background: repeating-linear-gradient(90deg, var(--ink) 0 2px, transparent 2px 4px, var(--ink) 4px 5px, transparent 5px 9px, var(--ink) 9px 12px, transparent 12px 14px);
    opacity: 0.75;
  }
  .card-hint { color: var(--ink-faint); font-size: 1rem; }

  /* ── stats ── */
  .about__stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(14px, 2vw, 22px); }
  .about__stats :global(.stat-win .win__body) { padding: 14px 16px 16px; }
  .stat { font-family: var(--font-pixel); font-weight: 700; font-size: clamp(1.8rem, 3.6vw, 2.8rem); line-height: 1.05; color: var(--pink-500); font-variant-numeric: tabular-nums; }
  .stat__label { font-size: 0.88rem; color: var(--ink-soft); }
  .focus {
    grid-column: 1 / -1; position: relative;
    padding: 18px 20px; border-radius: 18px;
    background: #fffbe6; border: 2px solid #f5d98b;
    box-shadow: 0 10px 24px -16px rgba(180, 130, 0, 0.5);
    transform: rotate(-1.2deg);
  }
  .focus::before { content: ''; position: absolute; left: 50%; top: -12px; width: 90px; height: 24px; translate: -50% 0; rotate: 3deg; background: rgba(250, 147, 210, 0.7); border-radius: 2px; }
  .focus__title { font-size: 1.2rem; color: var(--ink); margin-bottom: 8px; }
  .focus__list { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0 0 10px; padding: 0; }
  .focus__list li {
    font-family: var(--font-pixel); font-weight: 500; font-size: 1rem;
    padding: 4px 12px; border-radius: 8px; background: #fff; border: 2px solid var(--pink-300); color: var(--pink-500);
  }
  .focus__list li:nth-child(2) { border-color: var(--lilac-300); color: var(--lilac-400); }
  .focus__list li:nth-child(3) { border-color: var(--sky-300); color: #5b86d6; }
  .focus__list li:nth-child(4) { border-color: var(--peach-300); color: #e0707a; }
  .focus__tag { font-size: 0.9rem; color: var(--ink-faint); }

  /* ── draggable stickers ── */
  .stickers { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .sticker {
    position: absolute; pointer-events: auto; touch-action: none; cursor: grab;
    display: grid; place-items: center;
    width: 76px; height: 76px; border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 3px #fff, 0 12px 20px -10px rgba(74, 31, 46, 0.45);
    user-select: none;
  }
  .sticker:active { cursor: grabbing; }
  .sticker svg { width: 58%; height: 58%; }
  .sticker.s-peach { background: none; box-shadow: none; width: 104px; height: 104px; }
  .sticker.s-peach :global(svg) { width: 100%; height: 100%; }
  .s-text { width: auto; height: auto; border-radius: 12px; padding: 8px 14px; font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; color: var(--pink-500); border: 2px solid var(--pink-200); }
  .s-peach { left: 4%; top: 10%; rotate: -8deg; }
  .s-cat { right: 6%; top: 8%; rotate: 10deg; }
  .s-ghost { left: 2%; top: 58%; rotate: -12deg; }
  .s-pad { right: 3%; top: 52%; rotate: 8deg; }
  .s-cube { left: 44%; top: 4%; rotate: 6deg; width: 64px; height: 64px; }
  .s-mic { right: 16%; bottom: 4%; rotate: -6deg; width: 64px; height: 64px; }
  .s-heart { left: 16%; bottom: 3%; rotate: 12deg; width: 60px; height: 60px; }
  .s-star { right: 30%; top: 2%; rotate: -10deg; width: 56px; height: 56px; }
  .s-she { left: 24%; top: 3%; rotate: -5deg; }
  .s-th { right: 24%; bottom: 10%; rotate: 4deg; }
  .s-fan { left: 36%; bottom: 2%; rotate: -3deg; }
  .sticker-hint { position: absolute; left: 7%; top: calc(10% + 110px); color: var(--ink-faint); font-size: 1.05rem; rotate: -6deg; }

  @media (max-width: 900px) {
    .about__grid { grid-template-columns: 1fr; }
    .s-cube, .s-star, .s-she, .s-th, .s-mic, .s-pad { display: none; }
    .s-peach { width: 78px; height: 78px; left: 2%; top: 5%; }
    .s-cat { top: 4%; width: 58px; height: 58px; }
    .s-ghost { top: auto; bottom: 1%; left: 3%; width: 58px; height: 58px; }
    .s-heart { left: auto; right: 5%; bottom: 1%; }
    .s-fan { left: 30%; bottom: 0.5%; }
    .sticker-hint { display: none; }
  }
  @media (max-width: 520px) {
    .about__stats { grid-template-columns: 1fr 1fr; gap: 12px; }
    .stat { font-size: 1.55rem; }
  }
</style>
