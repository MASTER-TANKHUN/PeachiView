---
/**
 * ลูกพีชน้อย — PeachiView's peach plush, redrawn as SVG.
 * mood: happy | sleep | wow  (JS can swap data-mood at runtime)
 * phones: wears Peachi's pink cat-ear headphones
 */
interface Props {
  id: string;
  mood?: 'happy' | 'sleep' | 'wow';
  class?: string;
  label?: string;
  idle?: boolean;
  phones?: boolean;
}
const { id, mood = 'happy', class: cls = '', label, idle = true, phones = true } = Astro.props;
const g = (s: string) => `${id}-${s}`;
const body = 'M100 54C86 36 57 31 38 46 18 62 14 97 23 128c10 36 42 58 77 58s67-22 77-58c9-31 5-66-15-82-19-15-48-10-62 8Z';
---

<svg
  class:list={['peach', cls, idle && 'peach--idle']}
  data-mood={mood}
  viewBox="0 0 200 200"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  overflow="visible"
>
  <defs>
    <radialGradient id={g('body')} cx="34%" cy="30%" r="80%">
      <stop offset="0" stop-color="#fff3df"></stop>
      <stop offset=".3" stop-color="#ffcfae"></stop>
      <stop offset=".68" stop-color="#ff9db0"></stop>
      <stop offset="1" stop-color="#f26b96"></stop>
    </radialGradient>
    <radialGradient id={g('rim')} cx="78%" cy="82%" r="40%">
      <stop offset="0" stop-color="#fff" stop-opacity=".45"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id={g('leaf')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#b6f0a6"></stop>
      <stop offset=".55" stop-color="#6fcf73"></stop>
      <stop offset="1" stop-color="#3f9e58"></stop>
    </linearGradient>
    <linearGradient id={g('eye')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2e1414"></stop>
      <stop offset=".7" stop-color="#5a2a24"></stop>
      <stop offset="1" stop-color="#8a4636"></stop>
    </linearGradient>
    <linearGradient id={g('cup')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffc2e3"></stop>
      <stop offset="1" stop-color="#f77fbf"></stop>
    </linearGradient>
  </defs>

  <ellipse class="peach__shadow" cx="100" cy="194" rx="56" ry="6.5" fill="#4a1f2e" opacity=".14"></ellipse>
  <g class="peach__bob">
    <g class="peach__squish">
      <path class="peach__body" d={body} fill={`url(#${g('body')})`}></path>
      <path d={body} fill={`url(#${g('rim')})`}></path>
      <path d={body} fill="none" stroke="#e65a8d" stroke-width="3.4" stroke-linejoin="round"></path>
      <path class="peach__crease" d="M100 57c-8 20-8 42 4 64" fill="none" stroke="#ea6c96" stroke-width="3.2" stroke-linecap="round" opacity=".45"></path>
      <path d="M105 62c-4 14-3 27 3 39" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" opacity=".45"></path>
      <ellipse class="peach__shine" cx="58" cy="80" rx="16" ry="9.5" transform="rotate(-34 58 80)" fill="#fff" opacity=".75"></ellipse>
      <circle cx="80" cy="66" r="3.4" fill="#fff" opacity=".8"></circle>

      <g class="peach__leaves">
        <path class="peach__stem" d="M100 54c0-5 1-10 3-14" fill="none" stroke="#8a5a3c" stroke-width="4.5" stroke-linecap="round"></path>
        <path class="peach__leaf peach__leaf--l" d="M99 51C88 31 64 20 41 25c6 20 31 32 58 26Z" fill={`url(#${g('leaf')})`} stroke="#358a4c" stroke-width="3" stroke-linejoin="round"></path>
        <path class="peach__leaf peach__leaf--r" d="M102 50c7-24 32-39 58-34-6 23-31 38-58 34Z" fill={`url(#${g('leaf')})`} stroke="#358a4c" stroke-width="3" stroke-linejoin="round"></path>
        <path d="M95 48C83 40 67 33 51 29M106 47c13-10 30-20 46-26" fill="none" stroke="#e9ffe0" stroke-width="2.2" stroke-linecap="round" opacity=".75"></path>
      </g>

      {phones && (
        <g class="peach__phones">
          <path d="M26 120C24 52 176 52 174 120" fill="none" stroke="#fff" stroke-width="15" stroke-linecap="round"></path>
          <path class="peach__band" d="M26 120C24 52 176 52 174 120" fill="none" stroke="#fa93d2" stroke-width="9" stroke-linecap="round"></path>
          <path class="peach__ear peach__ear--l" d="M34 84 36 44l30 22Z" fill="#fa93d2" stroke="#fff" stroke-width="4" stroke-linejoin="round"></path>
          <path d="M40 72 41 55l12 9Z" fill="#ffd9ec"></path>
          <path class="peach__ear peach__ear--r" d="M166 84 164 44l-30 22Z" fill="#fa93d2" stroke="#fff" stroke-width="4" stroke-linejoin="round"></path>
          <path d="M160 72 159 55l-12 9Z" fill="#ffd9ec"></path>
          <rect x="8" y="98" width="30" height="46" rx="14" fill={`url(#${g('cup')})`} stroke="#fff" stroke-width="4"></rect>
          <rect x="162" y="98" width="30" height="46" rx="14" fill={`url(#${g('cup')})`} stroke="#fff" stroke-width="4"></rect>
          <circle cx="23" cy="121" r="5" fill="#fff" opacity=".85"></circle>
          <circle cx="177" cy="121" r="5" fill="#fff" opacity=".85"></circle>
        </g>
      )}

      <g class="peach__face">
        <g class="peach__eyes peach__eyes--open">
          <ellipse cx="73" cy="122" rx="11.5" ry="13.5" fill={`url(#${g('eye')})`}></ellipse>
          <ellipse cx="127" cy="122" rx="11.5" ry="13.5" fill={`url(#${g('eye')})`}></ellipse>
          <ellipse cx="73" cy="130" rx="7" ry="3.6" fill="#ff8fb8" opacity=".55"></ellipse>
          <ellipse cx="127" cy="130" rx="7" ry="3.6" fill="#ff8fb8" opacity=".55"></ellipse>
          <circle cx="68.5" cy="116" r="5.2" fill="#fff"></circle>
          <circle cx="122.5" cy="116" r="5.2" fill="#fff"></circle>
          <circle cx="77.5" cy="126" r="2.2" fill="#fff"></circle>
          <circle cx="131.5" cy="126" r="2.2" fill="#fff"></circle>
        </g>
        <g class="peach__eyes peach__eyes--sleep" fill="none" stroke="#4a2020" stroke-width="3.8" stroke-linecap="round">
          <path d="M61 121c7 8 17 8 24 0M115 121c7 8 17 8 24 0"></path>
        </g>
        <g class="peach__eyes peach__eyes--wow" fill="#4a2020">
          <path d="M73 106l4 11.6L89 122l-12 4.4L73 138l-4-11.6L57 122l12-4.4Z"></path>
          <path d="M127 106l4 11.6L143 122l-12 4.4L127 138l-4-11.6L111 122l12-4.4Z"></path>
          <circle cx="70" cy="118" r="2.4" fill="#fff"></circle><circle cx="124" cy="118" r="2.4" fill="#fff"></circle>
        </g>
        <path class="peach__mouth" d="M89 139q5.5 6.5 11 0q5.5 6.5 11 0" fill="none" stroke="#4a2020" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M96 141.5q4 5.5 8 0" fill="#ff6f9c" opacity=".85"></path>
        <g class="peach__blush">
          <ellipse cx="50" cy="141" rx="13" ry="7.5" fill="#ff5f98" opacity=".34"></ellipse>
          <ellipse cx="150" cy="141" rx="13" ry="7.5" fill="#ff5f98" opacity=".34"></ellipse>
          <path d="M43 144l4-6M50 145l4-6M57 144l4-6M143 144l4-6M150 145l4-6M157 144l4-6" stroke="#ff4f8a" stroke-width="2" stroke-linecap="round" opacity=".55"></path>
        </g>
      </g>

      <g class="peach__sparkles" fill="#fff">
        <path d="M44 58l2 6 6 2-6 2-2 6-2-6-6-2 6-2Z"></path>
        <path d="M150 76l1.4 4.2 4.2 1.4-4.2 1.4-1.4 4.2-1.4-4.2-4.2-1.4 4.2-1.4Z" opacity=".8"></path>
      </g>
      <g class="peach__zzz" fill="none" stroke="#7a4a5a" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M152 36h13l-13 14h13"></path>
        <path d="M172 12h10l-10 11h10"></path>
      </g>
    </g>
  </g>
</svg>

<style is:global>
  .peach { width: 100%; height: auto; overflow: visible; }
  .peach .peach__eyes--sleep,
  .peach .peach__eyes--wow,
  .peach .peach__zzz { display: none; }
  .peach[data-mood='sleep'] .peach__eyes--open,
  .peach[data-mood='wow'] .peach__eyes--open { display: none; }
  .peach[data-mood='sleep'] .peach__eyes--sleep,
  .peach[data-mood='sleep'] .peach__zzz,
  .peach[data-mood='wow'] .peach__eyes--wow { display: inline; }

  .peach__bob, .peach__squish, .peach__eyes, .peach__leaf, .peach__zzz path, .peach__shadow, .peach__ear, .peach__sparkles path {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .peach__eyes, .peach__sparkles path { transform-origin: 50% 50%; }
  .peach__leaf--l { transform-origin: 100% 100%; }
  .peach__leaf--r { transform-origin: 0% 100%; }
  .peach__ear--l { transform-origin: 80% 100%; }
  .peach__ear--r { transform-origin: 20% 100%; }

  @media (prefers-reduced-motion: no-preference) {
    .peach--idle .peach__bob { animation: peach-bob 2.6s ease-in-out infinite; }
    .peach--idle .peach__squish { animation: peach-squish 2.6s ease-in-out infinite; }
    .peach--idle .peach__shadow { animation: peach-shadow 2.6s ease-in-out infinite; transform-origin: 50% 50%; }
    .peach--idle .peach__eyes--open { animation: peach-blink 4.2s infinite; }
    .peach--idle .peach__leaf--l { animation: leaf-l 2.6s ease-in-out infinite; }
    .peach--idle .peach__leaf--r { animation: leaf-r 2.6s ease-in-out infinite; }
    .peach--idle .peach__ear--l { animation: ear-l 3.4s ease-in-out infinite; }
    .peach--idle .peach__ear--r { animation: ear-r 3.4s ease-in-out infinite 0.2s; }
    .peach--idle .peach__sparkles path { animation: twinkle 1.8s ease-in-out infinite; }
    .peach--idle .peach__sparkles path:nth-child(2) { animation-delay: 0.9s; }
    .peach[data-mood='sleep'] .peach__zzz path { animation: zzz 2.4s ease-in-out infinite; }
    .peach[data-mood='sleep'] .peach__zzz path:nth-child(2) { animation-delay: 0.8s; }
  }
  @keyframes peach-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }
  @keyframes peach-squish { 0%, 100% { transform: scale(1.035, 0.965); } 50% { transform: scale(0.98, 1.025); } }
  @keyframes peach-shadow { 0%, 100% { transform: scaleX(1); opacity: 0.14; } 50% { transform: scaleX(0.8); opacity: 0.08; } }
  @keyframes peach-blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(0.1); } }
  @keyframes leaf-l { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(-7deg); } }
  @keyframes leaf-r { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(8deg); } }
  @keyframes ear-l { 0%, 80%, 100% { transform: rotate(0); } 88% { transform: rotate(-14deg); } }
  @keyframes ear-r { 0%, 80%, 100% { transform: rotate(0); } 88% { transform: rotate(14deg); } }
  @keyframes twinkle { 0%, 100% { transform: scale(0.4) rotate(0deg); opacity: 0.3; } 50% { transform: scale(1.1) rotate(45deg); opacity: 1; } }
  @keyframes zzz { 0% { opacity: 0; transform: translate(0, 6px) scale(0.7); } 40% { opacity: 1; } 100% { opacity: 0; transform: translate(8px, -14px) scale(1.1); } }
</style>
