---
import { Picture } from 'astro:assets';
import PixelHeart from './svg/PixelHeart.astro';
import avatar from '../assets/models/v3-avatar.png';
import { videos, video, thumb, thaiDate, compact, daysWaited } from '../data/site';

const comeback = video('gp5nmWYqZeg');
const fresh = videos.filter((v) => v.era === 'v3').sort((a, b) => b.date.localeCompare(a.date));
---

<section class="comeback" id="comeback" aria-labelledby="comeback-title">
  <div class="comeback__bg" aria-hidden="true">
    <div class="comeback__rays"></div>
    <PixelHeart class="cbh cbh--1" /><PixelHeart class="cbh cbh--2" /><PixelHeart class="cbh cbh--3" />
  </div>

  <div class="wrap comeback__grid">
    <div class="poster-stage">
      <div class="poster" data-poster>
        <span class="pin pin--l" aria-hidden="true"></span><span class="pin pin--r" aria-hidden="true"></span>
        <p class="poster__head" aria-hidden="true">MISSING</p>
        <p class="poster__sub">หายตัวไป {daysWaited.toLocaleString('en-US')} วัน</p>
        <div class="poster__photo">
          <Picture src={avatar} alt="พีชชี่ร่างใหม่ในโปสเตอร์ตามหาคนหาย" widths={[400, 640, 820]} sizes="(max-width: 900px) 80vw, 420px" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" />
          <div class="poster__tape" aria-hidden="true"><span>MISSING</span></div>
        </div>
        <dl class="poster__info">
          <div><dt>ชื่อ</dt><dd>พีชชี่ (PeachiView)</dd></div>
          <div><dt>เห็นครั้งสุดท้าย</dt><dd>14 ม.ค. 2022 · ร้านไอติมใน Roblox</dd></div>
          <div><dt>จุดสังเกต</dt><dd>หูฟังหูแมวสีชมพู · ชอบลูกพีช</dd></div>
        </dl>
        <p class="poster__foot hand">ถ้าพบเห็น โปรดแจ้งลูกพีชน้อย ♡</p>
        <div class="found" aria-hidden="true">
          <span class="found__big">FOUND!</span>
          <span class="found__date">12 · 09 · 2026</span>
        </div>
      </div>
    </div>

    <div class="comeback__copy">
      <p class="kicker"><span class="live-dot"></span> {thaiDate(comeback.date)}</p>
      <h2 class="comeback__title" id="comeback-title" data-split>พีชชี่ กลับมาแล้ว!!</h2>
      <blockquote class="comeback__quote">
        <p class="hand">"ยังคิดถึงกันมั้ยคะ<br />พีชชี่กลับมาแล้วนะ"</p>
        <cite>— คำอธิบายคลิป "{comeback.title}"</cite>
      </blockquote>

      <button class="tv" type="button" data-video={comeback.id} aria-label={`เล่นคลิป ${comeback.title}`}>
        <span class="tv__ears" aria-hidden="true"><i></i><i></i></span>
        <span class="tv__body">
          <span class="tv__screen">
            <img src={thumb(comeback.id, 'sd')} srcset={`${thumb(comeback.id, 'sd')} 640w, ${thumb(comeback.id, 'maxres')} 1280w`} sizes="(max-width: 900px) 86vw, 460px" alt="" width="640" height="360" loading="lazy" />
            <span class="tv__scan" aria-hidden="true"></span>
            <span class="tv__play" aria-hidden="true"><svg><use href="#i-play"></use></svg></span>
          </span>
          <span class="tv__panel" aria-hidden="true"><i></i><i></i><b>CH 12</b></span>
        </span>
        <span class="tv__caption">▶ {comeback.title} · {compact(comeback.views)} วิว</span>
      </button>
    </div>
  </div>

  <div class="wrap fresh">
    <h3 class="fresh__title">คลิปใหม่หลังกลับมา <span class="fresh__badge">NEW!</span></h3>
    <ul class="fresh__list" data-fresh>
      {fresh.map((v) => (
        <li>
          <button class="fresh__card" type="button" data-video={v.id} aria-label={`เล่นคลิป ${v.title}`}>
            <span class="fresh__thumb">
              <img src={thumb(v.id, 'mq')} srcset={`${thumb(v.id, 'mq')} 320w, ${thumb(v.id, 'sd')} 640w`} sizes="(max-width: 700px) 70vw, 280px" alt="" width="320" height="180" loading="lazy" />
              <span class="fresh__kind">{v.kind === 'short' ? 'SHORTS' : v.length}</span>
            </span>
            <span class="fresh__name">{v.title}</span>
            <span class="fresh__meta">{thaiDate(v.date)} · {compact(v.views)} วิว</span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .comeback { position: relative; padding: clamp(90px, 12vw, 160px) 0 clamp(80px, 10vw, 140px); overflow: clip; isolation: isolate; }
  .comeback__bg { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, #d8c2ff 0%, #ffd9ef 18%, #fff3f9 60%, var(--paper) 100%); }
  .comeback__rays {
    position: absolute; left: 50%; top: 40%; width: 160vmax; aspect-ratio: 1; translate: -50% -50%;
    background: repeating-conic-gradient(from 0deg, rgba(255, 255, 255, 0.55) 0 6deg, transparent 6deg 18deg);
    mask-image: radial-gradient(circle, #000 0 20%, transparent 60%);
    animation: spin 60s linear infinite;
  }
  @keyframes spin { to { rotate: 360deg; } }
  .comeback__bg :global(.cbh) { position: absolute; width: 34px; }
  .comeback__bg :global(.cbh--1) { left: 8%; top: 14%; } .comeback__bg :global(.cbh--2) { right: 10%; top: 22%; width: 26px; } .comeback__bg :global(.cbh--3) { left: 46%; top: 6%; width: 22px; }

  .comeback__grid { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: clamp(32px, 5vw, 80px); align-items: center; }

  /* ── missing poster ── */
  .poster-stage { display: grid; justify-items: center; perspective: 1200px; }
  .poster {
    position: relative; width: min(420px, 88vw);
    padding: 26px 22px 20px; background: #fffdf6; color: var(--ink);
    border-radius: 4px; rotate: -2.5deg;
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.05), 0 30px 60px -30px rgba(74, 31, 46, 0.6);
    background-image: linear-gradient(rgba(74, 31, 46, 0.035) 1px, transparent 1px);
    background-size: 100% 26px;
  }
  .pin { position: absolute; top: 10px; width: 18px; height: 18px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #ff9ccf, #e8479f 70%); box-shadow: 0 3px 4px rgba(0, 0, 0, 0.3); }
  .pin--l { left: 14px; } .pin--r { right: 14px; }
  .poster__head { font-family: var(--font-pixel); font-weight: 700; font-size: clamp(2.6rem, 6vw, 3.6rem); line-height: 0.9; text-align: center; color: #e2334f; letter-spacing: 0.06em; }
  .poster__sub { text-align: center; font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; margin: 4px 0 12px; }
  .poster__photo { position: relative; aspect-ratio: 1 / 1.02; overflow: hidden; border: 3px solid var(--ink); background: radial-gradient(circle at 50% 35%, #fff, #ffe1ef 70%); }
  .poster__photo :global(img) { position: absolute; left: 50%; top: 0; width: 112%; max-width: none; height: auto; translate: -50% 0; }
  .poster__tape {
    position: absolute; left: -6%; right: -6%; top: 31%; height: 13%;
    display: grid; place-items: center;
    background: #e2334f; color: #fff;
    rotate: 5deg; transform-origin: 0% 50%;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    clip-path: polygon(0 8%, 4% 0, 12% 6%, 30% 0, 50% 5%, 70% 0, 88% 6%, 100% 0, 100% 92%, 94% 100%, 78% 94%, 60% 100%, 40% 95%, 20% 100%, 6% 94%, 0 100%);
  }
  .poster__tape span { font-family: var(--font-pixel); font-weight: 700; font-size: clamp(1.4rem, 3.2vw, 2rem); letter-spacing: 0.18em; }
  .poster__info { display: grid; gap: 4px; margin: 14px 0 8px; font-size: 0.88rem; }
  .poster__info div { display: grid; grid-template-columns: 8.6em 1fr; gap: 8px; }
  .poster__info dt { color: var(--ink-faint); }
  .poster__info dd { margin: 0; }
  .poster__foot { text-align: center; font-size: 1.1rem; color: var(--pink-500); }
  .found {
    position: absolute; left: 50%; top: 58%; translate: -50% -50%; rotate: -14deg;
    display: grid; justify-items: center; padding: 10px 22px 12px;
    border: 6px double #20a765; border-radius: 16px; color: #20a765;
    background: rgba(255, 255, 255, 0.35);
    mix-blend-mode: multiply;
    -webkit-mask: radial-gradient(circle at 30% 40%, #000 60%, rgba(0,0,0,.7) 61%) , linear-gradient(#000, #000);
  }
  :global(.js) .found { opacity: 0; }
  .found__big { font-family: var(--font-pixel); font-weight: 700; font-size: clamp(2.6rem, 7vw, 4.2rem); line-height: 1; letter-spacing: 0.04em; }
  .found__date { font-family: var(--font-pixel); font-size: 1rem; letter-spacing: 0.2em; }

  /* ── copy ── */
  .comeback__copy { display: grid; justify-items: start; gap: 18px; }
  .comeback__title { font-size: clamp(2.4rem, 5.6vw, 4.6rem); line-height: 1.25; color: var(--pink-500); text-shadow: 0 4px 0 #fff, 0 8px 0 var(--pink-200); }
  .comeback__quote { margin: 0; padding: 14px 18px; background: #fff; border-radius: 18px; border: 2px solid var(--pink-200); box-shadow: 6px 6px 0 var(--pink-200); rotate: -1deg; }
  .comeback__quote p { font-size: clamp(1.3rem, 2.4vw, 1.8rem); line-height: 1.35; }
  .comeback__quote cite { font-style: normal; font-size: 0.82rem; color: var(--ink-faint); }

  /* ── retro TV with cat-ear antennas ── */
  .tv { position: relative; width: min(460px, 100%); padding: 0; border: 0; background: none; text-align: center; display: grid; gap: 10px; }
  .tv__ears { position: absolute; left: 22%; right: 22%; top: -30px; height: 36px; display: flex; justify-content: space-between; }
  .tv__ears i { width: 44px; height: 44px; background: var(--pink-300); border: 3px solid var(--ink); border-radius: 6px 30px 4px 4px; rotate: -18deg; }
  .tv__ears i:last-child { rotate: 18deg; border-radius: 30px 6px 4px 4px; }
  .tv__body {
    position: relative; display: grid; grid-template-columns: 1fr 56px; gap: 12px;
    padding: 14px; border-radius: 26px; background: linear-gradient(180deg, #ffc3e2, #fa93d2);
    border: 3px solid var(--ink); box-shadow: 0 8px 0 var(--pink-600), 0 26px 40px -20px rgba(74, 31, 46, 0.6);
    transition: transform 0.35s var(--ease-pop);
  }
  .tv:hover .tv__body { transform: rotate(-1.5deg) scale(1.02); }
  .tv__screen { position: relative; display: block; aspect-ratio: 16/9; border-radius: 16px; overflow: hidden; border: 3px solid var(--ink); background: #222; }
  .tv__screen img { width: 100%; height: 100%; object-fit: cover; }
  .tv__scan { position: absolute; inset: 0; background: repeating-linear-gradient(180deg, rgba(0,0,0,.12) 0 2px, transparent 2px 4px); mix-blend-mode: multiply; }
  .tv__play { position: absolute; inset: 0; margin: auto; width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.92); color: var(--pink-500); box-shadow: 0 8px 20px -6px rgba(0,0,0,.4); }
  .tv__play svg { width: 28px; height: 28px; margin-left: 4px; }
  .tv__panel { display: grid; place-self: center; align-content: center; justify-items: center; gap: 10px; }
  .tv__panel i { width: 30px; height: 30px; border-radius: 50%; background: #fff; border: 3px solid var(--ink); }
  .tv__panel b { font-family: var(--font-pixel); font-size: 0.7rem; color: var(--ink); }
  .tv__caption { font-size: 0.9rem; color: var(--ink-soft); }

  /* ── fresh uploads ── */
  .fresh { margin-top: clamp(60px, 8vw, 100px); }
  .fresh__title { display: flex; align-items: center; gap: 10px; font-size: clamp(1.4rem, 2.6vw, 2rem); margin-bottom: 20px; }
  .fresh__badge { font-family: var(--font-pixel); font-size: 0.9rem; color: #fff; background: #ff4f7a; padding: 3px 10px; border-radius: 8px; rotate: -6deg; animation: wiggle 1.2s ease-in-out infinite; }
  @keyframes wiggle { 50% { rotate: 6deg; } }
  .fresh__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr)); gap: 18px; }
  .fresh__card { width: 100%; padding: 10px; border: 0; border-radius: 16px; background: #fff; box-shadow: var(--shadow-card); text-align: left; display: grid; gap: 6px; transition: transform 0.3s var(--ease-pop); }
  .fresh__card:hover { transform: translateY(-6px) rotate(-1deg); }
  .fresh__thumb { position: relative; display: block; aspect-ratio: 16/9; border-radius: 10px; overflow: hidden; background: var(--pink-100); }
  .fresh__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .fresh__kind { position: absolute; right: 6px; bottom: 6px; background: rgba(74,31,46,.85); color: #fff; font-family: var(--font-pixel); font-size: 0.72rem; padding: 1px 6px; border-radius: 5px; }
  .fresh__name { font-weight: 400; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .fresh__meta { font-size: 0.78rem; color: var(--ink-faint); }

  @media (max-width: 900px) {
    .comeback__grid { grid-template-columns: 1fr; }
    .comeback__copy { justify-items: center; text-align: center; }
    .tv { margin-top: 30px; }
  }
</style>
