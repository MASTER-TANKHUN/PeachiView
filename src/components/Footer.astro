---
import { Picture } from 'astro:assets';
import PeachMascot from './svg/PeachMascot.astro';
import PixelHeart from './svg/PixelHeart.astro';
import banner from '../assets/misc/banner-band.jpg';
import { socials, profile } from '../data/site';
---

<footer class="footer" aria-labelledby="footer-title">
  <div class="footer__banner" aria-hidden="true">
    <Picture src={banner} alt="" widths={[800, 1600]} sizes="100vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" />
  </div>
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <p class="footer__logo" id="footer-title">Peachiview</p>
      <p class="footer__tag">{profile.tagline} 🍑</p>
      <p class="footer__cta hand">ไปกดติดตามพีชชี่กันเยอะๆ นะ!</p>
    </div>
    <ul class="footer__social" aria-label="ช่องทางติดตาม PeachiView">
      {socials.map((s, i) => (
        <li style={`--rot:${[-6, 4, -3, 7][i]}deg`}>
          <a href={s.url} target="_blank" rel="noopener" class={`soc soc--${s.icon}`} data-magnetic>
            <svg aria-hidden="true"><use href={`#i-${s.icon}`} /></svg>
            <span><b>{s.name}</b><small>{s.handle}</small></span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="footer__bottom wrap">
    <p class="credit">
      Made with <span class="credit__peach" aria-label="ลูกพีช">🍑</span> by <b>Master Tankun | Tankhun Gaming</b>
      <span class="credit__sep" aria-hidden="true">·</span>
      <a href="https://github.com/MASTER-TANKHUN" target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#i-github"></use></svg>github</a>
    </p>
    <p class="footer__note">
      เว็บแฟนเมดโดยลูกพีชน้อย ไม่ใช่เว็บทางการของ PeachiView · ภาพ ตัวละคร และคลิปทั้งหมดเป็นของ PeachiView
    </p>
  </div>

  <button class="totop" type="button" data-totop aria-label="กลับขึ้นด้านบน">
    <PeachMascot id="tp" idle={false} />
    <span class="hand">ขึ้นบน</span>
  </button>
  <PixelHeart class="fh fh--1" /><PixelHeart class="fh fh--2" />
</footer>

<style>
  .footer { position: relative; padding: 0 0 calc(110px + env(safe-area-inset-bottom)); background: linear-gradient(180deg, var(--paper), #ffe1f0); overflow: clip; }
  .footer__banner { position: relative; height: clamp(90px, 14vw, 200px); overflow: hidden; mask-image: linear-gradient(180deg, transparent, #000 40%); }
  .footer__banner :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; }
  .footer__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 36px; align-items: center; padding: clamp(36px, 5vw, 60px) 0 30px; }
  .footer__logo {
    font-family: var(--font-pixel); font-weight: 700; font-size: clamp(2.6rem, 7vw, 5rem); line-height: 1;
    color: var(--pink-400); transform: skewX(-8deg); display: inline-block;
    text-shadow: 3px 3px 0 #fff, -3px 3px 0 #fff, 3px -3px 0 #fff, -3px -3px 0 #fff, 0 8px 0 var(--pink-200);
  }
  .footer__tag { font-family: var(--font-pixel); color: var(--ink-soft); letter-spacing: 0.06em; margin-top: 8px; }
  .footer__cta { font-size: 1.3rem; color: var(--pink-500); margin-top: 6px; }
  .footer__social { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .footer__social li { rotate: var(--rot); }
  .soc {
    display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 18px; text-decoration: none;
    background: #fff; border: 3px solid #fff; box-shadow: 0 0 0 2px var(--pink-200), 0 12px 24px -14px rgba(201, 45, 130, 0.6);
    transition: transform 0.3s var(--ease-pop), box-shadow 0.3s;
  }
  .soc:hover { transform: translateY(-4px) rotate(2deg) scale(1.03); box-shadow: 0 0 0 2px var(--pink-400), 0 18px 30px -14px rgba(201, 45, 130, 0.7); }
  .soc svg { width: 34px; height: 34px; flex: none; }
  .soc span { display: grid; line-height: 1.25; }
  .soc b { font-weight: 500; }
  .soc small { color: var(--ink-faint); font-size: 0.8rem; }
  .soc--youtube svg { color: #ff2d55; } .soc--x svg { color: #111; } .soc--instagram svg { color: #d6249f; } .soc--tiktok svg { color: #111; }

  .footer__bottom { border-top: 2px dashed var(--pink-200); padding-top: 22px; display: grid; gap: 6px; text-align: center; }
  .credit { font-size: 1rem; }
  .credit b { font-weight: 500; color: var(--pink-500); }
  .credit__sep { margin: 0 6px; color: var(--ink-faint); }
  .credit a { display: inline-flex; align-items: center; gap: 5px; color: var(--ink); font-weight: 400; }
  .credit a svg { width: 18px; height: 18px; }
  .footer__note { font-size: 0.8rem; color: var(--ink-faint); }

  .totop { position: absolute; right: clamp(14px, 4vw, 48px); bottom: calc(96px + env(safe-area-inset-bottom)); display: grid; justify-items: center; gap: 2px; width: 74px; padding: 0; border: 0; background: none; color: var(--ink-soft); }
  .totop :global(.peach) { width: 64px; }
  .footer > :global(.fh) { position: absolute; width: 30px; }
  .footer > :global(.fh--1) { left: 6%; bottom: 150px; } .footer > :global(.fh--2) { right: 22%; top: 180px; width: 22px; }
  @media (max-width: 900px) {
    .footer__grid { grid-template-columns: 1fr; text-align: center; justify-items: center; }
    .footer__social { width: 100%; }
    .totop { position: relative; right: auto; bottom: auto; margin: 20px auto 0; }
  }
  @media (max-width: 480px) { .footer__social { grid-template-columns: 1fr; } }
</style>
