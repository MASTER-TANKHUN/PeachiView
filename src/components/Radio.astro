---
/**
 * "radio.exe" — the party section. A big pastel turntable plays the song through a visible
 * YouTube player; when it starts the lights come on: a peach disco ball drops in, beams sweep,
 * speakers pump, EQ bars jump and the karaoke box follows the lyrics (LRC in src/data/site.ts).
 */
import Scribble from './svg/Scribble.astro';
import { song } from '../data/site';

const label = 'PEACHI RADIO ✦ ' + song.title.toUpperCase() + ' ✦ WELCOME BACK ✦ ';
const bars = Array.from({ length: 36 }, (_, i) => i);
---

<section class="radio" id="radio" data-radio data-state="idle" data-song={JSON.stringify(song)} aria-labelledby="radio-title">
  <div class="radio__room" aria-hidden="true">
    <div class="radio__wall"></div>
    <div class="radio__party"></div>
    <div class="radio__dots"></div>
    <div class="radio__beams"><i></i><i></i><i></i><i></i></div>
    <div class="ball ball--l" data-ball>
      <span class="ball__string"></span>
      <svg class="ball__peach" viewBox="0 0 200 210">
        <defs>
          <pattern id="tiles" width="16" height="16" patternUnits="userSpaceOnUse">
            <rect width="16" height="16" fill="#f7a8c8"></rect>
            <rect x="1" y="1" width="6.5" height="6.5" fill="#ffe3f0"></rect>
            <rect x="8.5" y="1" width="6.5" height="6.5" fill="#fbc7de"></rect>
            <rect x="1" y="8.5" width="6.5" height="6.5" fill="#f38fbc"></rect>
            <rect x="8.5" y="8.5" width="6.5" height="6.5" fill="#fff6fb"></rect>
          </pattern>
          <radialGradient id="ball-shade" cx="35%" cy="30%" r="75%">
            <stop offset="0" stop-color="#fff" stop-opacity=".55"></stop>
            <stop offset=".5" stop-color="#fff" stop-opacity="0"></stop>
            <stop offset="1" stop-color="#8a1d55" stop-opacity=".45"></stop>
          </radialGradient>
          <clipPath id="ball-clip"><path transform="translate(0 10)" d="M100 54C86 36 57 31 38 46 18 62 14 97 23 128c10 36 42 58 77 58s67-22 77-58c9-31 5-66-15-82-19-15-48-10-62 8Z"></path></clipPath>
        </defs>
        <g clip-path="url(#ball-clip)">
          <rect class="ball__tiles" x="-40" y="30" width="320" height="180" fill="url(#tiles)"></rect>
          <rect x="0" y="30" width="200" height="180" fill="url(#ball-shade)"></rect>
        </g>
        <g transform="translate(0 10)">
          <path d="M100 54C86 36 57 31 38 46 18 62 14 97 23 128c10 36 42 58 77 58s67-22 77-58c9-31 5-66-15-82-19-15-48-10-62 8Z" fill="none" stroke="#e45d86" stroke-width="3"></path>
          <path d="M99 51C88 31 64 20 41 25c6 20 31 32 58 26Zm3-1c7-24 32-39 58-34-6 23-31 38-58 34Z" fill="#6fcf73" stroke="#358a4c" stroke-width="3" stroke-linejoin="round"></path>
          <rect x="93" y="30" width="14" height="12" rx="3" fill="#d9c2cf" stroke="#9c7f8f" stroke-width="2"></rect>
        </g>
      </svg>
    </div>
    <div class="ball ball--r" data-ball>
      <span class="ball__string"></span>
      <svg class="ball__peach" viewBox="0 0 200 210">
        
        <g clip-path="url(#ball-clip)">
          <rect class="ball__tiles" x="-40" y="30" width="320" height="180" fill="url(#tiles)"></rect>
          <rect x="0" y="30" width="200" height="180" fill="url(#ball-shade)"></rect>
        </g>
        <g transform="translate(0 10)">
          <path d="M100 54C86 36 57 31 38 46 18 62 14 97 23 128c10 36 42 58 77 58s67-22 77-58c9-31 5-66-15-82-19-15-48-10-62 8Z" fill="none" stroke="#e45d86" stroke-width="3"></path>
          <path d="M99 51C88 31 64 20 41 25c6 20 31 32 58 26Zm3-1c7-24 32-39 58-34-6 23-31 38-58 34Z" fill="#6fcf73" stroke="#358a4c" stroke-width="3" stroke-linejoin="round"></path>
          <rect x="93" y="30" width="14" height="12" rx="3" fill="#d9c2cf" stroke="#9c7f8f" stroke-width="2"></rect>
        </g>
      </svg>
    </div>
  </div>

  <header class="wrap radio__head" data-reveal>
    <p class="kicker radio__kicker"><svg width="14" height="14" aria-hidden="true"><use href="#i-note"></use></svg> radio.exe</p>
    <h2 class="title-xl radio__title" id="radio-title"><span class="nw">เปิดเพลง</span><wbr /><span class="hl">ฉลอง<Scribble variant={2} /></span><wbr /><span class="nw">การกลับมา</span></h2>
    <p class="lead radio__lead">"{song.title}" — ฟังไปด้วยกัน แล้วขอพรให้พีชชี่ ✦</p>
  </header>

  <div class="radio__stage wrap">
    <div class="speaker speaker--l" aria-hidden="true">
      <span class="speaker__ears"><i></i><i></i></span>
      <span class="speaker__tw"></span>
      <span class="speaker__woof"><span></span></span>
    </div>

    <div class="tt" data-tt>
      <div class="tt__deck">
        <div class="tt__platter">
          <svg class="tt__vinyl" viewBox="0 0 200 200" data-vinyl>
            <defs>
              <radialGradient id="tt-vinyl" cx="50%" cy="50%" r="50%">
                <stop offset="0" stop-color="#3b2533"></stop>
                <stop offset=".72" stop-color="#241520"></stop>
                <stop offset="1" stop-color="#120a10"></stop>
              </radialGradient>
              <radialGradient id="tt-label" cx="40%" cy="35%" r="70%">
                <stop offset="0" stop-color="#ffe6f3"></stop>
                <stop offset="1" stop-color="#fa93d2"></stop>
              </radialGradient>
              <path id="tt-arc" d="M100 100m-29 0a29 29 0 1 1 58 0a29 29 0 1 1-58 0"></path>
            </defs>
            <circle cx="100" cy="100" r="99" fill="url(#tt-vinyl)"></circle>
            {[93, 88, 83, 78, 73, 68, 63, 58, 53, 48].map((r, i) => (
              <circle cx="100" cy="100" r={r} fill="none" stroke={i % 3 ? 'rgba(255,255,255,.06)' : 'rgba(255,190,225,.10)'} stroke-width="1.1" />
            ))}
            <circle cx="100" cy="100" r="40" fill="url(#tt-label)"></circle>
            <circle cx="100" cy="100" r="40" fill="none" stroke="#fff" stroke-width="1.5" opacity=".7"></circle>
            <text font-family="Pixelify Sans, monospace" font-size="7" font-weight="700" fill="#c92d82" letter-spacing=".5">
              <textPath href="#tt-arc">{label}</textPath>
            </text>
            <use href="#i-peach" x="84" y="82" width="32" height="32"></use>
            <circle cx="100" cy="100" r="3" fill="#fff"></circle>
          </svg>
          <span class="tt__glare"></span>
        </div>
        <svg class="tt__arm" viewBox="0 0 90 230" data-arm aria-hidden="true">
          <circle cx="62" cy="26" r="22" fill="#fff" stroke="#e45d86" stroke-width="4"></circle>
          <circle cx="62" cy="26" r="8" fill="#fa93d2"></circle>
          <path d="M62 26 L66 150 Q66 176 44 196" fill="none" stroke="#fff" stroke-width="9" stroke-linecap="round"></path>
          <path d="M62 26 L66 150 Q66 176 44 196" fill="none" stroke="#ebcfe0" stroke-width="3.5" stroke-linecap="round"></path>
          <rect x="26" y="188" width="30" height="20" rx="5" transform="rotate(32 41 198)" fill="#f569c0" stroke="#fff" stroke-width="3"></rect>
        </svg>
        <div class="tt__panel" aria-hidden="true">
          <span class="tt__led"></span>
          <span class="tt__speed"><b>33</b><i>45</i></span>
          <span class="tt__knob"></span>
        </div>
        <p class="tt__brand" aria-hidden="true">PEACHI RADIO</p>
      </div>
      <div class="tt__notes" data-notes aria-hidden="true"></div>
    </div>

    <div class="speaker speaker--r" aria-hidden="true">
      <span class="speaker__ears"><i></i><i></i></span>
      <span class="speaker__tw"></span>
      <span class="speaker__woof"><span></span></span>
    </div>
  </div>

  <div class="radio__console wrap">
    <div class="win screen" data-reveal>
      <div class="win__bar">
        <span class="win__title"><svg width="16" height="16" aria-hidden="true"><use href="#i-film"></use></svg><span>music_video.mp4</span></span>
        <span class="win__btns" aria-hidden="true"><span class="win__btn"><svg><use href="#i-min"></use></svg></span><span class="win__btn"><svg><use href="#i-max"></use></svg></span><span class="win__btn"><svg><use href="#i-close"></use></svg></span></span>
      </div>
      <div class="screen__box">
        <div class="screen__yt" data-yt></div>
        <button class="screen__cover" type="button" data-play-cover aria-label={`เล่นเพลง ${song.title} — ${song.artist}`}>
          <img src={`https://i.ytimg.com/vi/${song.id}/sddefault.jpg`} alt="" width="640" height="480" loading="lazy" />
          <span class="screen__play"><svg aria-hidden="true"><use href="#i-play"></use></svg></span>
          <span class="screen__tip hand">กดเพื่อเปิดไฟ &amp; เปิดเพลง!</span>
        </button>
        <p class="screen__blocked" hidden data-blocked>
          เล่นในเว็บไม่ได้ 😢 <a href={`${song.url}&t=${Math.floor(song.start)}s`} target="_blank" rel="noopener">ไปฟังบน YouTube</a>
        </p>
      </div>
    </div>

    <div class="deckpanel" data-reveal>
      <p class="np__label"><span class="np__dot"></span> NOW PLAYING</p>
      <p class="np__title">{song.title}</p>
      <p class="np__artist">{song.artist}</p>
      <div class="np__ctl">
        <button class="ctl ctl--small" type="button" data-restart aria-label={`เริ่มใหม่ที่วินาที ${song.start}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.6-5.9M4 4v5h5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <button class="ctl ctl--big" type="button" data-toggle aria-label="เล่นเพลง">
          <svg class="ic-play" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-play"></use></svg>
          <svg class="ic-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4.2" height="14" rx="1.6" fill="currentColor"></rect><rect x="13.8" y="5" width="4.2" height="14" rx="1.6" fill="currentColor"></rect></svg>
        </button>
        <label class="vol">
          <span class="sr-only">ระดับเสียง</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5v14l-4.5-4.5H4Z" fill="currentColor"></path><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          <input type="range" min="0" max="100" value="70" data-vol />
        </label>
      </div>
      <div class="seek" data-seek role="slider" tabindex="0" aria-label="ตำแหน่งเพลง" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span class="seek__fill" data-fill></span>
        <span class="seek__peach" data-thumb><svg viewBox="0 0 24 24"><use href="#i-peach"></use></svg></span>
      </div>
      <p class="np__time"><span data-cur>0:36</span><span data-dur>--:--</span></p>
      <div class="karaoke" data-karaoke aria-hidden="true">
        <p class="karaoke__line karaoke__line--prev" data-k-prev></p>
        <p class="karaoke__line karaoke__line--now" data-k-now>♪ {song.title} ♪</p>
        <p class="karaoke__line karaoke__line--next" data-k-next>{song.artist}</p>
      </div>
    </div>
  </div>

  <div class="eq" aria-hidden="true">
    {bars.map(() => <i></i>)}
  </div>
  <p class="radio__wish hand">แตะที่ว่างๆ เพื่อปล่อยดาวขอพรให้พีชชี่ ✦ <span data-wish-count></span></p>
</section>

<style>
  .radio {
    position: relative; isolation: isolate; overflow: clip;
    padding: clamp(90px, 11vw, 150px) 0 clamp(110px, 12vw, 170px);
    color: #fff; cursor: crosshair;
  }
  .radio :where(button, a, input, label, [role='slider']) { cursor: pointer; }

  /* ── room & lights ── */
  .radio__room { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .radio__wall { position: absolute; inset: 0; background: radial-gradient(90% 70% at 50% 30%, #3a2f6e 0%, #221b46 55%, #16122f 100%); }
  .radio__party {
    position: absolute; inset: -10%; opacity: 0; transition: opacity 1.2s;
    background:
      radial-gradient(40% 40% at 20% 30%, rgba(245, 105, 192, 0.55), transparent 70%),
      radial-gradient(40% 40% at 80% 25%, rgba(169, 139, 214, 0.6), transparent 70%),
      radial-gradient(50% 45% at 50% 85%, rgba(157, 189, 247, 0.45), transparent 70%);
    animation: party 8s ease-in-out infinite alternate paused;
  }
  @keyframes party { to { transform: translate3d(3%, -2%, 0) rotate(6deg) scale(1.08); } }
  .radio__dots {
    position: absolute; inset: -30%; opacity: 0; transition: opacity 1s;
    background-image:
      radial-gradient(circle, rgba(255,255,255,.9) 0 2px, transparent 3px),
      radial-gradient(circle, rgba(255,190,230,.8) 0 1.6px, transparent 2.6px),
      radial-gradient(circle, rgba(200,220,255,.8) 0 1.4px, transparent 2.4px);
    background-size: 90px 70px, 130px 110px, 70px 90px;
    background-position: 0 0, 40px 30px, 20px 60px;
    animation: dots 14s linear infinite paused;
  }
  @keyframes dots { to { transform: rotate(360deg); } }
  .radio__beams { position: absolute; left: 0; right: 0; top: -10%; height: 110%; opacity: 0; transition: opacity 0.8s; }
  .radio__beams i {
    position: absolute; top: 0; width: 34vw; height: 100%; transform-origin: 50% 0;
    background: conic-gradient(from 168deg at 50% 0, transparent 0deg, rgba(255, 170, 220, 0.35) 12deg, transparent 24deg);
    filter: blur(6px); mix-blend-mode: screen;
  }
  .radio__beams i:nth-child(1) { left: 2%; }
  .radio__beams i:nth-child(2) { left: 26%; background: conic-gradient(from 168deg at 50% 0, transparent 0deg, rgba(190, 160, 255, 0.35) 12deg, transparent 24deg); }
  .radio__beams i:nth-child(3) { left: 44%; background: conic-gradient(from 168deg at 50% 0, transparent 0deg, rgba(160, 200, 255, 0.32) 12deg, transparent 24deg); }
  .radio__beams i:nth-child(4) { left: 66%; }
  .radio[data-state='playing'] .radio__party,
  .radio[data-state='playing'] .radio__dots,
  .radio[data-state='playing'] .radio__beams { opacity: 1; }
  .radio[data-state='playing'] .radio__party, .radio[data-state='playing'] .radio__dots { animation-play-state: running; }

  .ball { position: absolute; top: 0; width: clamp(96px, 10vw, 150px); translate: -50% -100%; transition: translate 1.2s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .ball--l { left: 12%; }
  .ball--r { left: 88%; transition-delay: 0.15s; }
  .ball--r .ball__string { height: clamp(70px, 11vw, 150px); }
  .ball--r .ball__peach { animation-delay: -1.4s; }
  .radio[data-state='playing'] .ball { translate: -50% 0; }
  .ball__string { display: block; width: 3px; height: clamp(40px, 7vw, 90px); margin: 0 auto; background: linear-gradient(#fff0, #e9d6ff); }
  .ball__peach { width: 100%; height: auto; filter: drop-shadow(0 0 30px rgba(255, 170, 220, 0.7)); animation: sway 3s ease-in-out infinite alternate; transform-origin: 50% -40%; }
  @keyframes sway { from { rotate: -4deg; } to { rotate: 4deg; } }
  .ball__tiles { animation: tiles 2.4s linear infinite; }
  @keyframes tiles { to { transform: translateX(-32px); } }

  /* ── heading ── */
  .radio__head { display: grid; justify-items: center; text-align: center; gap: 14px; margin-bottom: clamp(20px, 4vw, 40px); position: relative; }
  .radio__kicker { background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.4); color: #fff; }
  .radio__title { color: #fff; }
  .radio__title .nw { white-space: nowrap; }
  .radio__title .hl { color: var(--pink-300); }
  .radio__lead { color: #f1e6ff; }

  /* ── stage: speakers + turntable ── */
  .radio__stage { position: relative; display: grid; grid-template-columns: 1fr minmax(0, auto) 1fr; align-items: end; gap: clamp(10px, 3vw, 40px); }
  .speaker {
    position: relative; justify-self: center; width: clamp(120px, 13vw, 180px); aspect-ratio: 3 / 4.4;
    border-radius: 26px; background: linear-gradient(170deg, #ffc9e4, #f58fc4);
    border: 4px solid #fff; box-shadow: 0 24px 40px -20px rgba(0, 0, 0, 0.6), inset 0 -8px 0 rgba(201, 45, 130, 0.25);
    display: grid; justify-items: center; align-content: space-evenly; padding: 14px 0 18px;
  }
  .speaker__ears { position: absolute; left: 10%; right: 10%; top: -24px; display: flex; justify-content: space-between; }
  .speaker__ears i { width: 38px; height: 38px; background: #f58fc4; border: 4px solid #fff; border-radius: 6px 30px 4px 4px; rotate: -15deg; }
  .speaker__ears i:last-child { border-radius: 30px 6px 4px 4px; rotate: 15deg; }
  .speaker__tw { width: 30%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, #fff 0 25%, #4a1f2e 30% 60%, #2a111b 62%); border: 3px solid #fff; }
  .speaker__woof { width: 70%; aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; background: radial-gradient(circle, #6d3050 0 18%, #3a1a2b 20% 62%, #2a111b 64%); border: 4px solid #fff; }
  .speaker__woof span { width: 38%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #ffb3d9, #e8479f); }

  .tt { position: relative; }
  .tt__deck {
    position: relative; width: clamp(300px, 36vw, 520px); aspect-ratio: 1.22;
    border-radius: 30px; background: linear-gradient(160deg, #ffe7f3 0%, #fbc3df 100%);
    border: 5px solid #fff; box-shadow: 0 40px 70px -30px rgba(0, 0, 0, 0.7), inset 0 -10px 0 rgba(201, 45, 130, 0.2);
  }
  .tt__platter { position: absolute; left: 6%; top: 8%; width: 70%; aspect-ratio: 1; border-radius: 50%; background: #e3c7d7; box-shadow: inset 0 0 0 6px #f6dfe9, 0 16px 30px -12px rgba(0, 0, 0, 0.5); }
  .tt__vinyl { position: absolute; inset: 4%; width: 92%; height: 92%; will-change: transform; }
  .tt__glare { position: absolute; inset: 4%; border-radius: 50%; pointer-events: none; background: conic-gradient(from 20deg, transparent 0 25deg, rgba(255,255,255,.22) 40deg, transparent 58deg 200deg, rgba(255,255,255,.14) 215deg, transparent 232deg); }
  .tt__arm { position: absolute; right: 3%; top: 4%; width: 17%; height: auto; transform-origin: 68.9% 11.3%; rotate: -28deg; transition: rotate 1s var(--ease-pop); filter: drop-shadow(0 6px 4px rgba(0,0,0,.25)); }
  .radio[data-state='playing'] .tt__arm { rotate: -2deg; }
  .tt__panel { position: absolute; right: 5%; bottom: 8%; display: grid; justify-items: center; gap: 10px; }
  .tt__led { width: 12px; height: 12px; border-radius: 50%; background: #caa9bb; }
  .radio[data-state='playing'] .tt__led { background: #3ad07a; box-shadow: 0 0 12px #3ad07a; }
  .tt__speed { display: flex; gap: 4px; font-family: var(--font-pixel); font-size: 0.7rem; color: var(--ink); }
  .tt__speed b, .tt__speed i { font-style: normal; padding: 2px 6px; border-radius: 6px; background: #fff; }
  .tt__speed b { background: var(--pink-400); color: #fff; }
  .tt__knob { width: 30px; height: 30px; border-radius: 50%; background: #fff; box-shadow: inset 0 -3px 0 var(--pink-200); }
  .tt__brand { position: absolute; left: 8%; bottom: 3.5%; font-family: var(--font-pixel); font-weight: 700; font-size: clamp(0.7rem, 1vw, 0.9rem); letter-spacing: 0.2em; color: var(--pink-500); }
  .tt__notes { position: absolute; inset: 0; pointer-events: none; }
  .tt__notes :global(svg) { position: absolute; left: 40%; top: 40%; width: 26px; height: 26px; color: var(--pink-200); filter: drop-shadow(0 0 6px rgba(255, 170, 220, 0.8)); }

  /* ── console: video screen + controls ── */
  .radio__console { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(18px, 3vw, 36px); margin-top: clamp(30px, 5vw, 56px); align-items: stretch; color: var(--ink); }
  .screen { align-self: start; }
  .screen__box { position: relative; aspect-ratio: 16 / 9; min-height: 200px; background: #1a1016; }
  .screen__yt, .screen__yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .screen__cover { position: absolute; inset: 0; padding: 0; border: 0; background: #1a1016; overflow: hidden; }
  .screen__cover img { width: 100%; height: 100%; object-fit: cover; filter: saturate(1.1) brightness(0.8); }
  .screen__play {
    position: absolute; left: 50%; top: 50%; width: 86px; height: 86px; translate: -50% -50%;
    display: grid; place-items: center; border-radius: 50%; background: var(--pink-400); color: #fff;
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.9), 0 0 0 14px rgba(245, 105, 192, 0.35), 0 20px 40px -10px rgba(0, 0, 0, 0.6);
    animation: pulse 1.6s ease-in-out infinite;
  }
  .screen__play svg { width: 36px; height: 36px; margin-left: 5px; }
  @keyframes pulse { 50% { scale: 1.08; } }
  .screen__tip { position: absolute; left: 50%; bottom: 12%; translate: -50% 0; white-space: nowrap; font-size: 1.2rem; color: #fff; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6); }
  .screen__blocked { position: absolute; inset: 0; display: grid; place-content: center; gap: 6px; text-align: center; color: #fff; padding: 20px; }
  .screen__blocked[hidden] { display: none; }
  .screen__blocked a { color: var(--pink-200); }

  .deckpanel {
    display: grid; align-content: start; gap: 10px;
    padding: clamp(18px, 2.4vw, 28px); border-radius: 24px;
    background: rgba(255, 255, 255, 0.94); border: 3px solid #fff;
    box-shadow: 0 0 0 2px var(--pink-300), 0 30px 60px -30px rgba(0, 0, 0, 0.7);
  }
  .np__label { display: flex; align-items: center; gap: 8px; font-family: var(--font-pixel); font-size: 0.8rem; letter-spacing: 0.14em; color: var(--ink-faint); }
  .np__dot { width: 9px; height: 9px; border-radius: 50%; background: #caa9bb; }
  .radio[data-state='playing'] .np__dot { background: #3ad07a; box-shadow: 0 0 8px #3ad07a; }
