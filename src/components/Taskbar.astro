---
/** PeachiOS taskbar — a status bar, not a menu: it lights up the part of the story you're in. */
const items = [
  { id: 'about', icon: 'user', label: 'พีชชี่' },
  { id: 'models', icon: 'layers', label: 'ร่าง' },
  { id: 'journey', icon: 'cal', label: 'ไดอารี่' },
  { id: 'wait', icon: 'clock', label: 'รอคอย' },
  { id: 'comeback', icon: 'heart', label: 'คัมแบ็ก' },
  { id: 'radio', icon: 'note', label: 'เพลง' },
  { id: 'videos', icon: 'film', label: 'คลิป' },
  { id: 'letter', icon: 'mail', label: 'จดหมาย' },
];
---
<div class="progress" aria-hidden="true"><span class="progress__bar"></span><svg class="progress__peach"><use href="#i-peach"></use></svg></div>
<div class="taskbar" aria-hidden="true">
  <span class="taskbar__start" data-start>
    <svg><use href="#i-peach"></use></svg><span>start</span>
  </span>
  <ul class="taskbar__list">
    {items.map((it) => (
      <li data-nav={it.id}>
        <svg><use href={`#i-${it.icon}`} /></svg>
        <span>{it.label}</span>
      </li>
    ))}
  </ul>
  <span class="taskbar__clock" data-clock>--:--</span>
</div>

<style>
  .progress { position: fixed; left: 0; right: 0; top: 0; height: 5px; z-index: 900; pointer-events: none; }
  .progress__bar { position: absolute; inset: 0; background: linear-gradient(90deg, var(--pink-300), var(--pink-400), var(--lilac-400)); transform-origin: 0 50%; transform: scaleX(0); border-radius: 0 4px 4px 0; }
  .progress__peach { position: absolute; top: -2px; left: 0; width: 20px; height: 20px; margin-left: -10px; }

  .taskbar {
    position: fixed; left: 0; right: 0; bottom: calc(14px + env(safe-area-inset-bottom)); z-index: 900;
    width: max-content; margin-inline: auto;
    display: flex; align-items: center; gap: 6px;
    padding: 6px; border-radius: 20px;
    background: rgba(255, 255, 255, 0.82); backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border: 2px solid var(--pink-200);
    box-shadow: 0 16px 40px -18px rgba(201, 45, 130, 0.6);
    max-width: calc(100vw - 20px);
  }
  .taskbar__start {
    display: flex; align-items: center; gap: 6px; padding: 6px 12px 6px 8px; border-radius: 14px;
    background: linear-gradient(180deg, #ffc9e8, #f9a3d6); border: 2px solid var(--pink-300);
    font-family: var(--font-pixel); font-weight: 700; color: var(--ink); font-size: 0.9rem;
    cursor: pointer; user-select: none;
  }
  .taskbar__start svg { width: 22px; height: 22px; }
  .taskbar__list { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .taskbar__list li {
    display: grid; justify-items: center; gap: 0; padding: 5px 10px 3px; border-radius: 12px;
    color: var(--ink-faint); font-size: 0.7rem; line-height: 1.2; user-select: none;
    transition: background 0.3s, color 0.3s, opacity 0.3s;
  }
  .taskbar__list li svg { width: 22px; height: 22px; transition: scale 0.4s var(--ease-pop); }
  .taskbar__list li.is-active { background: var(--pink-100); color: var(--pink-600); }
  .taskbar__list li.is-active svg { scale: 1.15; }
  .taskbar__clock { font-family: var(--font-pixel); font-size: 0.85rem; color: var(--ink-soft); padding: 0 10px 0 6px; font-variant-numeric: tabular-nums; }
  @media (max-width: 700px) {
    .taskbar__start span, .taskbar__clock { display: none; }
    .taskbar__start { padding: 6px; }
    .taskbar__list li { padding: 5px 6px 3px; font-size: 0.62rem; }
    .taskbar__list li svg { width: 20px; height: 20px; }
  }
  @media (max-width: 460px) {
    .taskbar__list li span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .taskbar__list li { padding: 7px; }
  }
</style>
