---
/** Floating mini player: shows while you are away from the #radio section so the song can be paused from anywhere. */
import { song } from '../data/site';
---
<div class="mini" data-mini data-state="idle">
  <button class="mini__disc" type="button" data-mini-main aria-label={`เปิดเพลง ${song.title}`}>
    <span class="mini__vinyl" aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#i-peach"></use></svg></span>
    <span class="mini__state" aria-hidden="true">
      <svg class="ic-play" viewBox="0 0 24 24"><use href="#i-play"></use></svg>
      <svg class="ic-pause" viewBox="0 0 24 24"><rect x="6" y="5" width="4.2" height="14" rx="1.6" fill="currentColor"></rect><rect x="13.8" y="5" width="4.2" height="14" rx="1.6" fill="currentColor"></rect></svg>
    </span>
  </button>
  <a class="mini__txt" href="#radio" data-mini-jump>
    <b data-mini-title>เปิดเพลง ♪</b>
    <small>{song.title} · {song.artist}</small>
  </a>
  <span class="mini__eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <p class="mini__ticker hand" aria-hidden="true" data-mini-ticker></p>
</div>

<style>
  .mini {
    position: fixed; left: calc(16px + env(safe-area-inset-left)); bottom: calc(16px + env(safe-area-inset-bottom)); z-index: 950;
    display: flex; align-items: center; gap: 10px;
    padding: 6px 14px 6px 6px; border-radius: 99px; border: 2px solid var(--pink-200);
    background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 14px 30px -14px rgba(201, 45, 130, 0.7);
  }
  :global(.js) .mini { opacity: 0; visibility: hidden; }
  .mini__disc { position: relative; width: 50px; height: 50px; padding: 0; border: 0; border-radius: 50%; background: none; flex: none; }
  .mini__vinyl {
    position: absolute; inset: 0; border-radius: 50%; display: grid; place-items: center;
    background: radial-gradient(circle, #fa93d2 0 27%, transparent 28%), repeating-radial-gradient(circle, #2a1822 0 2px, #3a2531 2px 4px);
    box-shadow: inset 0 0 0 2px #140b12;
    animation: spin 2.2s linear infinite paused;
  }
  .mini__vinyl svg { width: 16px; height: 16px; }
  .mini[data-state='playing'] .mini__vinyl { animation-play-state: running; }
  @keyframes spin { to { rotate: 360deg; } }
  .mini__state {
    position: absolute; right: -4px; bottom: -4px; width: 22px; height: 22px; display: grid; place-items: center;
    border-radius: 50%; background: var(--pink-400); color: #fff; border: 2px solid #fff;
  }
  .mini__state svg { width: 11px; height: 11px; }
  .mini__state .ic-play { margin-left: 2px; }
  .mini__state .ic-pause, .mini[data-state='playing'] .mini__state .ic-play { display: none; }
  .mini[data-state='playing'] .mini__state .ic-pause { display: block; }
  .mini__txt { display: grid; line-height: 1.25; text-decoration: none; }
  .mini__txt b { font-family: var(--font-display); font-size: 0.95rem; color: var(--pink-500); }
  .mini__txt small { font-size: 0.72rem; color: var(--ink-faint); max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mini__eq { display: none; gap: 3px; align-items: end; height: 20px; }
  .mini[data-state='playing'] .mini__eq { display: flex; }
  .mini__eq i { width: 4px; border-radius: 2px; background: var(--pink-400); animation: eqb 0.8s ease-in-out infinite alternate; }
  .mini__eq i:nth-child(2) { animation-delay: 0.25s; } .mini__eq i:nth-child(3) { animation-delay: 0.5s; } .mini__eq i:nth-child(4) { animation-delay: 0.1s; }
  @keyframes eqb { from { height: 4px; } to { height: 20px; } }
  .mini__ticker {
    position: absolute; left: 0; bottom: calc(100% + 10px); max-width: min(360px, calc(100vw - 32px)); width: max-content;
    padding: 6px 14px; border-radius: 14px; background: rgba(255,255,255,.96); border: 2px solid var(--pink-200);
    color: var(--ink); font-size: 1.05rem; line-height: 1.35; pointer-events: none;
    box-shadow: 0 10px 20px -12px rgba(201, 45, 130, 0.7);
    opacity: 0; transform: translateY(8px); transition: opacity 0.3s, transform 0.3s var(--ease-pop);
  }
  .mini__ticker.is-on { opacity: 1; transform: none; }
  @media (max-width: 700px) {
    .mini { left: auto; right: calc(12px + env(safe-area-inset-right)); bottom: calc(86px + env(safe-area-inset-bottom)); padding: 5px; }
    .mini__txt, .mini__eq { display: none !important; }
    .mini__ticker { left: auto; right: 0; }
  }
</style>
